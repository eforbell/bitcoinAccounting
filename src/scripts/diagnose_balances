#!/usr/bin/env python3
"""Diagnose and report issues in wallet balances and transaction records.

Identifies problems like:
- Negative balances (where they shouldn't exist)
- Unmatched transfers (withdrawals without deposits)
- Missing transfer pairs
- Fee inconsistencies

Usage:
    diagnose_balances [COIN]
    
Examples:
    diagnose_balances BTC
    diagnose_balances ALGO
"""

import sys
import _bootstrap
from bitcoinAccounts import BitcoinAccounts
from datetime import datetime, timedelta


def main():
    coin = sys.argv[1].upper() if len(sys.argv) > 1 else 'BTC'
    
    crypto = BitcoinAccounts()
    
    try:
        print(f"\n{'=' * 80}")
        print(f"Balance Diagnostics for {coin}")
        print(f"{'=' * 80}\n")
        
        # Get all wallet balances
        wallet_balances = crypto.get_wallet_balance(coin, wallet=None)
        
        # Find wallets with negative balances
        negative_wallets = {w: b for w, b in wallet_balances.items() if b < -0.00000001}
        
        if negative_wallets:
            print(f"⚠️  NEGATIVE BALANCES DETECTED ({len(negative_wallets)} wallets)")
            print(f"{'-' * 80}\n")
            
            for wallet, balance in sorted(negative_wallets.items(), key=lambda x: x[1]):
                print(f"Wallet: {wallet}")
                print(f"Balance: {balance:.8f} {coin}")
                print(f"\nRecent transactions:")

                # Get recent transactions for this wallet
                query = """
                    SELECT createddate, trans_type,
                           buy, buy_curr, sell, sell_curr, fee, fee_curr,
                           id, comment
                    FROM ledger
                    WHERE exchange = :wallet
                        AND (buy_curr = :coin OR sell_curr = :coin OR fee_curr = :coin)
                    ORDER BY createddate DESC
                    LIMIT 10
                """
                transactions = crypto.backend.execute(query, {'wallet': wallet, 'coin': coin})

                for tx in transactions:
                    date = tx['createddate']
                    parts = []
                    if tx['buy'] and tx['buy_curr'] == coin:
                        parts.append(f"+{float(tx['buy']):.8f} {coin}")
                    if tx['sell'] and tx['sell_curr'] == coin:
                        parts.append(f"-{float(tx['sell']):.8f} {coin}")
                    if tx['fee'] and tx['fee_curr'] == coin:
                        parts.append(f"(fee: {float(tx['fee']):.8f})")

                    tx_summary = " ".join(parts)
                    date_str = date.strftime('%Y-%m-%d') if hasattr(date, 'strftime') else str(date)[:10]
                    print(f"  {date_str} | {tx['trans_type']:<15} | {tx_summary}")

                # Calculate what balance should be
                balance_query = """
                    SELECT
                        COALESCE(SUM(CASE WHEN buy_curr = :coin THEN buy ELSE 0 END), 0) as total_buy,
                        COALESCE(SUM(CASE WHEN sell_curr = :coin THEN sell ELSE 0 END), 0) as total_sell,
                        COALESCE(SUM(CASE WHEN fee_curr = :coin THEN fee ELSE 0 END), 0) as total_fee
                    FROM ledger
                    WHERE exchange = :wallet
                """
                result = crypto.backend.execute_one(balance_query, {'coin': coin, 'wallet': wallet})
                total_buy = float(result['total_buy']) if result['total_buy'] else 0.0
                total_sell = float(result['total_sell']) if result['total_sell'] else 0.0
                total_fee = float(result['total_fee']) if result['total_fee'] else 0.0
                
                print(f"\n  Components:")
                print(f"    Total deposits/buys:     +{total_buy:.8f}")
                print(f"    Total withdrawals/sells: -{total_sell:.8f}")
                print(f"    Total fees (tracking):    {total_fee:.8f}")
                print(f"    Net balance:             {(total_buy - total_sell):.8f}")
                
                # Suggest fixes
                print(f"\n  💡 Possible causes:")
                if abs(balance) < 0.001:
                    print(f"    • Rounding/dust - likely safe to ignore")
                else:
                    print(f"    • Missing deposit transaction (check if withdrawal has matching deposit)")
                    print(f"    • Incorrect fee attribution")
                    print(f"    • Transfer recorded in wrong wallet")
                
                print(f"\n{'-' * 80}\n")
        else:
            print(f"✅ No negative balances detected\n")
        
        # Check for orphaned withdrawals/deposits
        print(f"Checking for unmatched transfers...")
        print(f"{'-' * 80}\n")

        # Get all withdrawals (with fees since sell includes fee)
        withdrawal_query = """
            SELECT id, createddate, sell, sell_curr, fee, fee_curr, exchange, comment
            FROM ledger
            WHERE trans_type = 'Withdrawal'
                AND sell_curr = :coin
            ORDER BY createddate DESC
        """
        withdrawals = crypto.backend.execute(withdrawal_query, {'coin': coin})

        # Get all deposits
        deposit_query = """
            SELECT id, createddate, buy, buy_curr, exchange, comment
            FROM ledger
            WHERE trans_type = 'Deposit'
                AND buy_curr = :coin
            ORDER BY createddate DESC
        """
        deposits = crypto.backend.execute(deposit_query, {'coin': coin})
        
        unmatched_withdrawals = []
        unmatched_deposits = []
        consolidations_withdrawal = []
        consolidations_deposit = []
        
        # Matching logic: withdrawal.sell includes fee, so compare (sell - fee) to deposit.buy
        for withdrawal in withdrawals:
            w_id = withdrawal['id']
            w_date = withdrawal['createddate']
            w_sell = float(withdrawal['sell'])
            w_fee_curr = withdrawal['fee_curr']
            w_fee = float(withdrawal['fee']) if (withdrawal['fee'] and w_fee_curr == coin) else 0.0
            w_exchange = withdrawal['exchange']
            w_net_amount = w_sell - w_fee  # Net amount transferred (excluding fee)

            matched = False
            is_consolidation = False

            for deposit in deposits:
                d_id = deposit['id']
                d_date = deposit['createddate']
                d_amount = float(deposit['buy'])
                d_exchange = deposit['exchange']
                
                # Match: withdrawal net amount should equal deposit amount
                time_diff = abs((d_date - w_date).total_seconds())
                amount_diff = abs(d_amount - w_net_amount)
                amount_ratio = amount_diff / w_net_amount if w_net_amount > 0 else 1.0
                
                # Check if same wallet (consolidation/UTXO management)
                if time_diff < 259200 and amount_ratio < 0.03 and d_exchange == w_exchange:  # 72 hours for consolidations
                    is_consolidation = True
                    break
                # Check if different wallet (actual transfer) - allow up to 72h for delayed free withdrawals
                elif time_diff < 259200 and amount_ratio < 0.03 and d_exchange != w_exchange:
                    matched = True
                    break
            
            if is_consolidation:
                consolidations_withdrawal.append(withdrawal)
            elif not matched:
                unmatched_withdrawals.append(withdrawal)
        
        # Check deposits
        for deposit in deposits:
            d_id = deposit['id']
            d_date = deposit['createddate']
            d_amount = float(deposit['buy'])
            d_exchange = deposit['exchange']

            matched = False
            is_consolidation = False

            for withdrawal in withdrawals:
                w_date = withdrawal['createddate']
                w_sell = float(withdrawal['sell'])
                w_fee_curr = withdrawal['fee_curr']
                w_fee = float(withdrawal['fee']) if (withdrawal['fee'] and w_fee_curr == coin) else 0.0
                w_exchange = withdrawal['exchange']
                w_net_amount = w_sell - w_fee
                
                time_diff = abs((d_date - w_date).total_seconds())
                amount_diff = abs(d_amount - w_net_amount)
                amount_ratio = amount_diff / w_net_amount if w_net_amount > 0 else 1.0
                
                # Check if same wallet (consolidation/UTXO management)
                if time_diff < 259200 and amount_ratio < 0.03 and d_exchange == w_exchange:  # 72 hours
                    is_consolidation = True
                    break
                # Check if different wallet (actual transfer) - allow up to 72h for delayed free withdrawals
                elif time_diff < 259200 and amount_ratio < 0.03 and d_exchange != w_exchange:
                    matched = True
                    break
            
            if is_consolidation:
                consolidations_deposit.append(deposit)
            elif not matched:
                unmatched_deposits.append(deposit)
        
        # Report consolidations (same-wallet UTXO management)
        if consolidations_withdrawal or consolidations_deposit:
            consolidation_count = max(len(consolidations_withdrawal), len(consolidations_deposit))
            print(f"ℹ️  {consolidation_count} same-wallet consolidation(s) detected (UTXO management - not cross-wallet transfers)")
            print()
        
        if unmatched_withdrawals:
            print(f"⚠️  {len(unmatched_withdrawals)} unmatched withdrawal(s):")
            for tx in unmatched_withdrawals[:10]:  # Show first 10
                sell = float(tx['sell'])
                fee = float(tx['fee']) if (tx['fee'] and tx['fee_curr'] == coin) else 0.0
                net_amount = sell - fee
                date = tx['createddate']
                date_str = date.strftime('%Y-%m-%d') if hasattr(date, 'strftime') else str(date)[:10]
                print(f"  {date_str} | {tx['exchange']:<15} | {sell:.8f} (net: {net_amount:.8f}) {tx['sell_curr']}")
            if len(unmatched_withdrawals) > 10:
                print(f"  ... and {len(unmatched_withdrawals) - 10} more")
            print()

        if unmatched_deposits:
            print(f"⚠️  {len(unmatched_deposits)} unmatched deposit(s):")
            for tx in unmatched_deposits[:10]:
                date = tx['createddate']
                date_str = date.strftime('%Y-%m-%d') if hasattr(date, 'strftime') else str(date)[:10]
                print(f"  {date_str} | {tx['exchange']:<15} | {float(tx['buy']):.8f} {tx['buy_curr']}")
            if len(unmatched_deposits) > 10:
                print(f"  ... and {len(unmatched_deposits) - 10} more")
            print()
        
        if not unmatched_withdrawals and not unmatched_deposits:
            print(f"✅ All transfers appear to be matched\n")
        
        print(f"{'=' * 80}")
        print(f"Summary:")
        print(f"  Wallets with negative balances: {len(negative_wallets)}")
        print(f"  Unmatched withdrawals: {len(unmatched_withdrawals)}")
        print(f"  Unmatched deposits: {len(unmatched_deposits)}")
        print(f"{'=' * 80}\n")
        
        if negative_wallets or unmatched_withdrawals or unmatched_deposits:
            print("💡 Recommendations:")
            print("  1. Review transaction history for wallets with negative balances")
            print("  2. Check if withdrawals have corresponding deposits (and vice versa)")
            print("  3. Verify fee amounts are attributed to correct wallets")
            print("  4. Consider using transfer_funds() method to record paired transfers")
            print()
        
    except Exception as e:
        print(f"ERROR: {e}", file=sys.stderr)
        import traceback
        traceback.print_exc()
        sys.exit(1)
    finally:
        crypto.close()


if __name__ == '__main__':
    main()
