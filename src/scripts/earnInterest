#!/usr/bin/env python3
"""Record interest or staking income. See SCRIPTS_DEPLOYMENT.md for setup."""

import sys
import _bootstrap
from cryptoAccounts import CryptoAccounts

from prompt_toolkit import print_formatted_text as print
from prompt_toolkit import PromptSession
from prompt_toolkit.shortcuts import yes_no_dialog
from datetime import datetime

now = datetime.now()
session = PromptSession()

def prompt_float(prompt_text: str, default: str = "") -> float:
    """Prompt for a float value with validation and re-prompting on error."""
    while True:
        try:
            value = session.prompt(prompt_text, default=default)
            return float(value)
        except ValueError:
            print(f"Invalid number. Please enter a valid numeric value.")

while True:
    try:
        exchange = session.prompt("Exchange/Source: ", default="River").strip()
        currency = session.prompt("Currency: ", default="BTC")
        amount = prompt_float(f"Amount ({currency}): ")
        interest_type = session.prompt("Type (Interest/Staking/Yield): ", default="Interest Income")
        
        tx_date = None
        while tx_date is None:
            tx_data_raw = session.prompt("Date (YYYY-MM-DD HH:MM:SS): ", default=now.strftime("%Y-%m-%d %H:%M:%S"))
            try:
                tx_date = datetime.strptime(tx_data_raw, '%Y-%m-%d %H:%M:%S')
            except ValueError:
                print("Invalid date format. Use YYYY-MM-DD HH:MM:SS")
        
        print(f"Exchange: {exchange}")
        print(f"Currency: {currency}")
        print(f"Amount: {amount}")
        print(f"Type: {interest_type}")
        print(f"Date: {tx_date}")

        confirm = yes_no_dialog(title="Record Income", text="Is this correct?").run()

        if confirm:
            crypto = CryptoAccounts()
            try:
                crypto.interest(
                    interest_date=tx_date,
                    buy=amount,
                    buy_curr=currency,
                    exchange=exchange,
                    group=""
                )
                print(f"Income recorded. New balance: {crypto.get_balance(currency):.8f} {currency}")
                crypto.close()
                break
            except Exception as e:
                print(f"Error recording income: {e}")
                crypto.close()
    except KeyboardInterrupt:
        break
    except EOFError:
        break

print("Exiting...")

