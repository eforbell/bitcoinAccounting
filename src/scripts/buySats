#!/usr/bin/env python3
"""Record Bitcoin purchase transaction. See SCRIPTS_DEPLOYMENT.md for setup."""

import sys
import _bootstrap
from bitcoinAccounts import BitcoinAccounts

from prompt_toolkit import print_formatted_text as print
from prompt_toolkit import HTML, PromptSession
from prompt_toolkit.shortcuts import yes_no_dialog
from datetime import datetime, timedelta

now = datetime.now()
session = PromptSession()

def prompt_float(prompt_text: str, default: str = "") -> float:
	"""Prompt for a float value with validation and re-prompting on error."""
	while True:
		try:
			value = session.prompt(prompt_text, default=default)
			return float(value)
		except ValueError:
			print(f"Invalid number. Please enter a valid numeric value.")

def prompt_int(prompt_text: str, default: str = "") -> int:
	"""Prompt for an integer value with validation and re-prompting on error."""
	while True:
		try:
			value = session.prompt(prompt_text, default=default)
			return int(value)
		except ValueError:
			print(f"Invalid number. Please enter a valid integer.")

while True:
	try:
		exchange = session.prompt("Exchange: ", default="Strike").strip()
		quantity = prompt_float("Quantity (BTC): ")
		# Instead of asking for price per BTC, ask for the total USD cost
		# (the recorded value you care about). The per-BTC price is
		# computed for informational purposes only.
		total_usd = prompt_float("Total cost (USD): ")
		fee_btc = prompt_float("Fee (BTC): ", default="0")
		group = session.prompt("Group (optional): ", default="")

		tx_date = None
		while tx_date is None:
			tx_data_raw = session.prompt("Purchase date (YYYY-MM-DD HH:MM:SS): ", default=now.strftime("%Y-%m-%d %H:%M:%S"))
			try:
				tx_date = datetime.strptime(tx_data_raw, '%Y-%m-%d %H:%M:%S')
			except ValueError:
				print("Invalid date format. Use YYYY-MM-DD HH:MM:SS")

		# Compute per-BTC price for display if quantity is non-zero
		computed_price = (total_usd / quantity) if quantity != 0 else None
		print(f"Exchange: {exchange}")
		print(f"Quantity: {quantity} BTC")
		if computed_price is not None:
			print(f"Price (computed): ${computed_price:.2f}/BTC")
		print(f"Total: ${total_usd:.2f}")
		print(f"Fee: {fee_btc} BTC")
		print(f"Date: {tx_date}")
		
		record_tx = session.prompt("Do you want to record this transaction? (Y/N) ")
		if record_tx.lower() in ('y', 'yes'):
			crypto = BitcoinAccounts()
			try:
				# Step 1: Deposit USD to exchange
				crypto.deposit(exchange=exchange, deposit_date=tx_date, buy=total_usd)
				tx_date = tx_date + timedelta(seconds=30)

				# Step 2: Execute trade (USD -> BTC)
				crypto.execute_trade(
					exchange=exchange,
					trade_date=tx_date,
					buy=quantity,
					buy_curr="BTC",
					sell=total_usd,
					sell_curr="USD",
					fee=fee_btc,
					fee_curr="BTC",
					group=group if group else None
				)
				tx_date = tx_date + timedelta(seconds=30)

				# Step 3: Optional withdrawal to cold storage/wallet
				withdrawing = session.prompt("Do you want to withdraw BTC? (Y/N) ")
				if withdrawing.lower() in ('y', 'yes'):
					withdraw_wallet = session.prompt("Withdraw to wallet: ", default="Ledger-2").strip()
					withdraw_delay_minutes = prompt_int("Withdraw delay (min): ", default="700")
					withdraw_date = tx_date + timedelta(minutes=withdraw_delay_minutes)
					crypto.transfer_funds(
						from_account=exchange,
						to_account=withdraw_wallet,
						withdraw_date=tx_date,
						deposit_date=withdraw_date,
						tx_amount=quantity,
						tx_coin="BTC"
					)
				
				print("Transaction recorded.")
				print(f"Current balance: {crypto.get_balance('BTC'):.8f} BTC @ ${crypto.get_basis('BTC'):.2f}/BTC")
				crypto.close()
				break
			except Exception as e:
				print(f"Error recording transaction: {e}")
				crypto.close()
	except KeyboardInterrupt:
		break
	except EOFError:
		break

print("Exiting...")


