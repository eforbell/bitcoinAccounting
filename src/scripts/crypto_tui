#!/usr/bin/env python3
"""Crypto Accounting TUI - Interactive terminal interface.

Provides a menu-driven interface to all crypto accounting functionality:
portfolio views, transaction recording, CSV imports, tax reporting,
and visualizations.

Usage:
    crypto_tui
"""

import sys
from pathlib import Path

# Add src/python to path for imports
sys.path.insert(0, str(Path(__file__).parent.parent / "python"))

# Load environment variables
try:
    from dotenv import load_dotenv
    repo_root = Path(__file__).resolve().parent.parent.parent
    load_dotenv(dotenv_path=repo_root / ".env", override=False)
except ImportError:
    pass

from tui.app import main

if __name__ == "__main__":
    main()
