#!/usr/bin/env python3
"""Display trade history and cost basis. See SCRIPTS_DEPLOYMENT.md for setup."""

import sys
import _bootstrap
from bitcoinAccounts import BitcoinAccounts


def main():
    crypto = BitcoinAccounts()
    
    if len(sys.argv) > 1:
        coin = sys.argv[1]
    else:
        coin = "BTC"

    try:
        print(f"\n{'='*70}")
        print(f"Trade History for {coin}")
        print(f"{'='*70}\n")
        crypto.print_trades(coin)
    finally:
        crypto.close()


if __name__ == '__main__':
    main()
