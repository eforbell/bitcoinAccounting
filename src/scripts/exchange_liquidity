#!/usr/bin/env python3
"""Show which exchanges have cost basis history (purchase records).

For 2025+ per-wallet FIFO: shows which exchanges have Trade (purchase) records
where you can transfer coins TO and sell with proper cost basis.

Critical insight: Current balance doesn't matter - what matters is where you
have PURCHASE HISTORY. Transfer coins to those exchanges to sell with basis.

Usage:
    exchange_liquidity [COIN] [--wallet=EXCHANGE]
    
Examples:
    exchange_liquidity               # BTC, all exchanges
    exchange_liquidity BTC           # Bitcoin, all exchanges
    exchange_liquidity BTC --wallet=Strike   # BTC at Strike only
    exchange_liquidity ALGO --wallet=Kraken  # ALGO at Kraken only
"""

import sys
import _bootstrap
from bitcoinAccounts import BitcoinAccounts


def get_all_purchase_data(crypto, coin):
    """Get all purchase data for a coin, grouped by exchange.

    Returns:
        dict: {exchange: {'purchased': float, 'usd_spent': float}}
    """
    # Fetch ALL trades once (not per exchange)
    all_trades = crypto.trade_query.get_trade_cost(coin, cost_currency='USD')

    # Group by exchange
    exchange_data = {}
    for t in all_trades:
        if t.get('quantity', 0) <= 0:  # Skip sales
            continue

        exchange = t.get('exchange', 'Unknown')
        if exchange not in exchange_data:
            exchange_data[exchange] = {'purchased': 0.0, 'usd_spent': 0.0}

        exchange_data[exchange]['purchased'] += t['quantity']
        if t.get('total_cost') is not None:
            exchange_data[exchange]['usd_spent'] += t['total_cost']

    return exchange_data


def main():
    # Parse arguments
    wallet = None
    coin = 'BTC'
    
    for arg in sys.argv[1:]:
        if arg.startswith('--wallet='):
            wallet = arg.split('=', 1)[1]
        elif not arg.startswith('--'):
            coin = arg.upper()
    
    crypto = BitcoinAccounts()
    
    try:
        print(f"\n{'=' * 100}")
        print(f"Purchase History & Cost Basis Tracking for {coin}")
        if wallet:
            print(f"Wallet: {wallet}")
        print(f"(Shows where you have explainable cost basis for 2025+ per-wallet FIFO)")
        print(f"{'=' * 100}\n")
        
        exchange_data = []
        total_all_purchases = 0
        total_still_at_exchange = 0
        total_usd_spent = 0

        # Fetch ALL purchase data once (not per exchange)
        all_purchases = get_all_purchase_data(crypto, coin)

        # Filter to specific wallet if requested
        if wallet:
            exchanges_to_process = {wallet: all_purchases.get(wallet, {'purchased': 0, 'usd_spent': 0})}
        else:
            exchanges_to_process = all_purchases

        for exchange, data in exchanges_to_process.items():
            purchased = data['purchased']
            usd_spent = data['usd_spent']

            if purchased > 0:  # Has purchase history
                # Get current balance (single query per exchange)
                balance = crypto.get_wallet_balance(coin, exchange)
                avg_cost = usd_spent / purchased if purchased > 0 else 0

                exchange_data.append({
                    'name': exchange,
                    'purchased': purchased,
                    'balance': balance,
                    'usd_spent': usd_spent,
                    'avg_cost': avg_cost
                })

                total_all_purchases += purchased
                total_still_at_exchange += balance
                total_usd_spent += usd_spent
        
        if exchange_data:
            print(f"{'Exchange':<20} {'Total Purchased':>18} {'Current Balance':>18} {'Avg Cost (USD)':>16}")
            print(f"{'-' * 76}")

            for data in sorted(exchange_data, key=lambda x: x['purchased'], reverse=True):
                avg_cost_str = f"${data['avg_cost']:,.2f}" if data['avg_cost'] > 0 else "N/A"
                print(f"{data['name']:<20} {data['purchased']:>18.8f} {data['balance']:>18.8f} {avg_cost_str:>16}")

            print(f"{'-' * 76}")
            total_avg_cost = total_usd_spent / total_all_purchases if total_all_purchases > 0 else 0
            total_avg_str = f"${total_avg_cost:,.2f}" if total_avg_cost > 0 else "N/A"
            print(f"{'TOTALS':<20} {total_all_purchases:>18.8f} {total_still_at_exchange:>18.8f} {total_avg_str:>16}")
        else:
            print(f"No purchase history found for {coin} at exchanges")
            print(f"All {coin} may have been acquired through deposits/transfers")
        
        # Get total balance
        total_balance = crypto.get_balance(coin)
        in_cold_storage = total_balance - total_still_at_exchange
        total_avg_cost = total_usd_spent / total_all_purchases if total_all_purchases > 0 else 0

        print(f"\n{'=' * 76}")
        print(f"Cost Basis Summary:")
        print(f"  Total purchased at exchanges:  {total_all_purchases:>18.8f} {coin}")
        print(f"  Total USD spent:               ${total_usd_spent:>17,.2f}")
        print(f"  Average cost basis:            ${total_avg_cost:>17,.2f} per {coin}")
        print(f"  Still at exchanges:            {total_still_at_exchange:>18.8f} {coin}")
        print(f"  In cold storage:               {in_cold_storage:>18.8f} {coin}")
        print(f"  TOTAL HOLDINGS:                {total_balance:>18.8f} {coin}")
        print(f"{'=' * 76}")

        if total_still_at_exchange > 0:
            print(f"\n✓ {total_still_at_exchange:.8f} {coin} at exchanges with known basis (avg ${total_avg_cost:,.2f})")

        if in_cold_storage > 0.00000001:  # Ignore dust
            print(f"\n⚠ {in_cold_storage:.8f} {coin} in cold storage - transfer chain needed for basis tracking")

        print(f"\n💡 Purchase history exists at these exchanges - this is your cost basis documentation")
        print()
        
    finally:
        crypto.close()


if __name__ == '__main__':
    main()
