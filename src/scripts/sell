#!/usr/bin/env python3
"""Record Bitcoin sale transaction. See SCRIPTS_DEPLOYMENT.md for setup."""

import sys
import os

# Establish Python module root from environment variables
module_root = os.getenv('CRYPTO_ACCOUNTING_PYTHONPATH')
if not module_root:
	repo_root = os.getenv('REPO_ROOT')
	if repo_root:
		module_root = os.path.join(repo_root, 'src', 'python')

if module_root and module_root not in sys.path:
	sys.path.insert(0, module_root)

try:
	from cryptoAccounts import CryptoAccounts
except ImportError as e:
	print("ERROR: Could not import cryptoAccounts. Please set REPO_ROOT or CRYPTO_ACCOUNTING_PYTHONPATH", file=sys.stderr)
	sys.exit(1)

from prompt_toolkit import PromptSession
from datetime import datetime, timedelta

now = datetime.now()
session = PromptSession()

while True:
	try:
		wallet_source = session.prompt("Bitcoin wallet source: ", default="CC")
		exchange = session.prompt("Exchange: ", default="Strike")
		quantity = session.prompt("Quantity (BTC) sold: ")
		price = session.prompt("Sale price per BTC (USD): ")
		fee = session.prompt("Fee (USD): ", default="0")

		tx_date = None
		while tx_date is None:
			tx_data_raw = session.prompt("Sale date (YYYY-MM-DD HH:MM:SS): ", default=now.strftime("%Y-%m-%d %H:%M:%S"))
			try:
				tx_date = datetime.strptime(tx_data_raw, '%Y-%m-%d %H:%M:%S')
			except ValueError:
				print("Invalid date format. Use YYYY-MM-DD HH:MM:SS")

		total_usd = float(quantity) * float(price)
		print(f"Wallet source: {wallet_source}")
		print(f"Exchange: {exchange}")
		print(f"Quantity: {quantity} BTC")
		print(f"Price: ${price}/BTC")
		print(f"Total: ${total_usd:.2f}")
		print(f"Fee: ${fee}")
		print(f"Net: ${total_usd - float(fee):.2f}")
		print(f"Date: {tx_date}")

		record_tx = session.prompt("Do you want to record this transaction? (Y/N) ")
		if record_tx == 'Y' or record_tx == 'y':
			crypto = CryptoAccounts()
			try:
				# Step 1: Transfer BTC from wallet to exchange
				# (done before the trade, with slight time delays)
				withdraw_date = tx_date - timedelta(minutes=70)
				deposit_date = tx_date - timedelta(minutes=10)
				crypto.transfer_funds(
					from_account=wallet_source,
					to_account=exchange,
					withdraw_date=withdraw_date,
					deposit_date=deposit_date,
					tx_amount=float(quantity),
					tx_coin="BTC"
				)
				
				# Step 2: Execute trade (BTC -> USD)
				crypto.execute_trade(
					exchange=exchange,
					trade_date=tx_date,
					buy=total_usd,
					buy_curr="USD",
					sell=float(quantity),
					sell_curr="BTC",
					fee=float(fee),
					fee_curr="USD"
				)
				tx_date = tx_date + timedelta(seconds=30)
				
				# Step 3: Optional withdrawal of USD back to wallet
				withdrawing = session.prompt("Do you want to withdraw USD? (Y/N) ")
				if withdrawing == 'Y' or withdrawing == 'y':
					withdraw_delay_minutes = session.prompt("Withdraw delay (min): ", default="0")
					withdraw_date = tx_date + timedelta(minutes=int(withdraw_delay_minutes))
					crypto.withdraw(
						withdraw_date=withdraw_date,
						sell=total_usd,
						sell_curr="USD",
						fee=float(fee),
						fee_curr="USD",
						exchange=wallet_source
					)
				
				print("Transaction recorded.")
				print(f"Current balance: {crypto.get_balance('BTC'):.8f} BTC @ ${crypto.get_basis('BTC'):.2f}/BTC")
				crypto.close()
				break
			except Exception as e:
				print(f"Error recording sale: {e}")
				crypto.close()
	except KeyboardInterrupt:
		break
	except EOFError:
		break

print("Exiting...")