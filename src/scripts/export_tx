#!/usr/bin/env python3
"""Export transaction ledger to CSV with filtering options.

Usage:
    export_tx [OPTIONS] [OUTPUT_FILE]

Examples:
    export_tx output.csv --wallet Strike --coin BTC
    export_tx output.csv --start-date 2024-01-01 --end-date 2024-12-31
    export_tx --wallet Coldcard --dry-run
    export_tx --coin BTC --start-date 2024-01-01
"""

import argparse
import sys
from datetime import datetime
from collections import defaultdict
import _bootstrap
from cryptoAccounts import CryptoAccounts


def parse_arguments():
    """Parse command-line arguments."""
    parser = argparse.ArgumentParser(
        description="Export transaction ledger to CSV with filtering options",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
Examples:
  # Basic export
  %(prog)s output.csv                                    # Export all transactions
  %(prog)s                                               # Export to ledger_export.csv (default)

  # Filter by wallet/exchange
  %(prog)s output.csv --wallet Strike                    # Export Strike transactions only
  %(prog)s output.csv --wallet Coldcard --coin BTC       # Export BTC from Coldcard
  %(prog)s output.csv --wallets Strike,Coldcard,Vault    # Export multiple wallets

  # Filter by date range
  %(prog)s output.csv --start-date 2024-01-01            # From Jan 1, 2024 onwards
  %(prog)s output.csv --end-date 2024-12-31              # Up to Dec 31, 2024
  %(prog)s output.csv --start-date 2024-01-01 --end-date 2024-12-31

  # Preview without exporting
  %(prog)s --wallet Strike --dry-run                     # Preview Strike transactions
  %(prog)s --coin BTC --start-date 2024-01-01 --dry-run  # Preview 2024 BTC transactions
        """
    )

    parser.add_argument(
        'output_file',
        nargs='?',
        default='ledger_export.csv',
        help='Output CSV file (default: ledger_export.csv)',
    )
    parser.add_argument(
        '--coin',
        metavar='COIN',
        help='Filter by cryptocurrency (e.g., BTC, ETH)',
    )
    parser.add_argument(
        '--wallet',
        metavar='WALLET',
        help='Filter by wallet/exchange name (e.g., Strike, Coldcard)',
    )
    parser.add_argument(
        '--wallets',
        metavar='WALLET1,WALLET2,...',
        help='Filter by multiple wallets (comma-separated, e.g., Strike,Coldcard,Vault)',
    )
    parser.add_argument(
        '--start-date',
        metavar='DATE',
        help='Start date in YYYY-MM-DD format',
    )
    parser.add_argument(
        '--end-date',
        metavar='DATE',
        help='End date in YYYY-MM-DD format',
    )
    parser.add_argument(
        '--dry-run',
        action='store_true',
        help='Preview transactions without exporting to file',
    )

    return parser.parse_args()


def validate_date(date_str, param_name):
    """Validate date format (YYYY-MM-DD).

    Args:
        date_str: Date string to validate
        param_name: Parameter name for error message

    Returns:
        str: Validated date string

    Raises:
        SystemExit: If date format is invalid
    """
    try:
        datetime.strptime(date_str, '%Y-%m-%d')
        return date_str
    except ValueError:
        print(f"Error: {param_name} must be in YYYY-MM-DD format. Got: {date_str}", file=sys.stderr)
        sys.exit(1)


def print_dry_run_preview(transactions, coin, wallet, start_date, end_date):
    """Print a formatted preview of transactions.

    Args:
        transactions: List of transaction dictionaries
        coin: Coin filter (or None)
        wallet: Wallet filter (string, list, or None)
        start_date: Start date filter (or None)
        end_date: End date filter (or None)
    """
    print(f"\n{'=' * 100}")
    print(f"Preview: {len(transactions)} transaction(s) matching filters")
    print(f"{'=' * 100}\n")

    # Display applied filters
    print("Filters:")
    if wallet:
        if isinstance(wallet, list):
            print(f"  Wallets:    {', '.join(wallet)}")
        else:
            print(f"  Wallet:     {wallet}")
    else:
        print(f"  Wallet:     All wallets")
    print(f"  Coin:       {coin if coin else 'All currencies'}")
    print(f"  Date range: {start_date if start_date else 'Beginning'} to {end_date if end_date else 'Now'}")
    print()

    if not transactions:
        print("No transactions found matching the specified filters.\n")
        return

    # Show first 5 transactions
    print("First 5 transactions:\n")
    print(f"{'Date':<20} {'Type':<15} {'Buy':>18} {'Sell':>18} {'Exchange':<20}")
    print(f"{'-' * 100}")

    for tx in transactions[:5]:
        date_val = tx.get('Date', '')
        date_str = str(date_val)[:19] if date_val else ''
        trans_type = tx.get('Type', '')

        buy_val = tx.get('Buy', '')
        buy_curr = tx.get('Buy Cur.', '')
        buy_str = f"{buy_val} {buy_curr}" if buy_val else ''

        sell_val = tx.get('Sell', '')
        sell_curr = tx.get('Sell Cur.', '')
        sell_str = f"{sell_val} {sell_curr}" if sell_val else ''

        exchange = tx.get('Exchange', '')

        print(f"{date_str:<20} {trans_type:<15} {buy_str:>18} {sell_str:>18} {exchange:<20}")

    if len(transactions) > 5:
        print(f"... and {len(transactions) - 5} more transaction(s)")

    print()

    # Calculate summary statistics
    print("Summary:")
    print(f"  Total transactions: {len(transactions)}")

    if transactions:
        # Date range
        dates = [tx.get('Date', '') for tx in transactions if tx.get('Date')]
        if dates:
            print(f"  Date range: {min(dates)} to {max(dates)}")

        # Exchange breakdown
        exchange_counts = defaultdict(int)
        for tx in transactions:
            exchange = tx.get('Exchange', 'Unknown')
            exchange_counts[exchange] += 1

        print(f"  Exchanges: {', '.join(f'{ex} ({ct})' for ex, ct in sorted(exchange_counts.items()))}")

    print(f"\n{'=' * 100}")
    print("Run without --dry-run to export to file.")
    print(f"{'=' * 100}\n")


def main():
    """Main entry point."""
    args = parse_arguments()

    # Validate mutually exclusive wallet options
    if args.wallet and args.wallets:
        print("Error: Cannot use both --wallet and --wallets. Use --wallets for multiple wallets.", file=sys.stderr)
        sys.exit(1)

    # Parse wallet filter
    wallet_filter = None
    if args.wallet:
        wallet_filter = args.wallet
    elif args.wallets:
        # Split comma-separated wallets and strip whitespace
        wallet_filter = [w.strip() for w in args.wallets.split(',')]

    # Validate dates if provided
    start_date = validate_date(args.start_date, '--start-date') if args.start_date else None
    end_date = validate_date(args.end_date, '--end-date') if args.end_date else None

    # Validate date range
    if start_date and end_date and start_date > end_date:
        print("Error: --start-date cannot be after --end-date", file=sys.stderr)
        sys.exit(1)

    # Initialize CryptoAccounts
    crypto = CryptoAccounts()

    try:
        # Get transactions with filters
        colnames, transactions = crypto.get_transactions(
            coin=args.coin,
            wallet=wallet_filter,
            start_date=start_date,
            end_date=end_date
        )

        # Dry-run preview
        if args.dry_run:
            print_dry_run_preview(transactions, args.coin, wallet_filter, start_date, end_date)
            sys.exit(0)

        # Export to CSV
        print(f"Exporting {len(transactions)} transaction(s) to {args.output_file}...")
        crypto.export_transactions_csv(
            args.output_file,
            coin=args.coin,
            wallet=wallet_filter,
            start_date=start_date,
            end_date=end_date
        )
        print(f"Export complete: {args.output_file}")

    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        import traceback
        traceback.print_exc(file=sys.stderr)
        sys.exit(2)
    finally:
        crypto.close()


if __name__ == '__main__':
    main()
