#!/usr/bin/env python3
"""Export transaction ledger to CSV. See SCRIPTS_DEPLOYMENT.md for setup."""

import sys
import _bootstrap
from cryptoAccounts import CryptoAccounts


def main():
    crypto = CryptoAccounts()
    
    if len(sys.argv) > 1:
        output_file = sys.argv[1]
    else:
        output_file = "ledger_export.csv"
    
    if len(sys.argv) > 2:
        coin = sys.argv[2]
    else:
        coin = None

    try:
        print(f"Exporting transactions to {output_file}...")
        crypto.export_transactions_csv(output_file, coin)
        print(f"Export complete: {output_file}")
    except Exception as e:
        print(f"Error exporting transactions: {e}", file=sys.stderr)
        sys.exit(1)
    finally:
        crypto.close()


if __name__ == '__main__':
    main()
