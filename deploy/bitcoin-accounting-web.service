[Unit]
Description=Bitcoin Accounting Web API
After=network.target postgresql.service

[Service]
Type=simple
User=bitcoin-accounting
WorkingDirectory=/data/apps/bitcoinAccounting
EnvironmentFile=/data/apps/bitcoinAccounting/.env
Environment=PYTHONUNBUFFERED=1
# The launcher, not uvicorn directly: it binds the socket SOVEREIGN_LISTEN names (Home Base), else this host and port.
# Tailnet mode trusts identity headers only because nothing but nginx can reach that socket.
ExecStart=/data/apps/bitcoinAccounting/.venv/bin/bitcoin-accounting-web --host 127.0.0.1 --port 3010
Restart=always
RestartSec=5
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
