# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Tax export files (temporary/personal data)
# Generated CSV files should not be committed (except examples)
1099b_*.csv
*_worksheet.csv
forecast_*.csv
wallet_balance_*.csv

# Allow example files in docs
!docs/examples/*.csv

# Personal wallet INSERT statements (if users create custom wallet data files)
src/sql/wallets_personal.sql
src/sql/wallets_insert_*.sql

# Distribution / packaging
build/
dist/
eggs/
parts/
bin/
var/
sdist/
develop-eggs/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.tox/
*.cover
*.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/
.pytest_cache/

# Translations
*.mo

# Django stuff:
*.log
local_settings.py
db.sqlite3

# IPython/Jupyter
.ipynb_checkpoints

# pyenv
.python-version

# envs
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs site
/site

# mypy
.mypy_cache/

# VS Code
.vscode/

# macOS
.DS_Store

# Linux trash
.Trash-*

# Editor temp files
*~
*.swp
*.swo

# Logs
*.log

# Allow adding this repo's README and other top-level config
!README.md
!requirements.txt
# Sensitive transaction data
*.csv
*-transactions.csv

# Database credentials
src/python/config.py
