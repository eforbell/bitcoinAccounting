# CryptoAccounting Environment Configuration
#
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it contains sensitive credentials

# Database Backend Selection
# Options: 'sqlite' (default, no config needed) or 'postgres'
DB_BACKEND=sqlite

# SQLite Configuration (only if using SQLite backend)
# Path to SQLite database file. Default: ~/.cryptoaccounting/ledger.db
# SQLITE_DB_PATH=/path/to/your/ledger.db

# PostgreSQL Configuration (required if DB_BACKEND=postgres)
# Hostname or IP address of PostgreSQL server
PGHOST=

# PostgreSQL port (default: 5432)
PGPORT=5432

# PostgreSQL username
PGUSER=

# PostgreSQL password - KEEP THIS SECRET
PGPASSWORD=

# PostgreSQL database name
PGDATABASE=

# PostgreSQL SSL mode (optional)
# Options: disable, allow, prefer, require, verify-ca, verify-full
# PGSSLMODE=require
