# BitcoinAccounting Environment Configuration
#
# IMPORTANT: Copy this file to .env and fill in your actual values
# NEVER commit .env to version control - it contains sensitive credentials

# Database Backend Selection
# Options: 'sqlite' (default, no config needed) or 'postgres'
DB_BACKEND=sqlite

# SQLite Configuration (only if using SQLite backend)
# Path to SQLite database file. Default: ~/.bitcoinaccounting/ledger.db
# SQLITE_DB_PATH=/path/to/your/ledger.db

# PostgreSQL Configuration (required if DB_BACKEND=postgres)
# Hostname or IP address of PostgreSQL server
PGHOST=

# PostgreSQL port (default: 5432)
PGPORT=5432

# PostgreSQL username
PGUSER=

# PostgreSQL password - KEEP THIS SECRET
PGPASSWORD=

# PostgreSQL database name
PGDATABASE=

# PostgreSQL SSL mode (optional)
# Options: disable, allow, prefer, require, verify-ca, verify-full
# PGSSLMODE=require

# Web app configuration
BITCOIN_ACCOUNTING_ENV=development
BITCOIN_ACCOUNTING_WEB_BASE_PATH=
BITCOIN_ACCOUNTING_WEB_DOCS=1
BITCOIN_ACCOUNTING_WEB_ALLOW_SQLITE=0

# Web auth/session
BITCOIN_ACCOUNTING_AUTH_ENABLED=0
BITCOIN_ACCOUNTING_AUTH_PASSPHRASE=
BITCOIN_ACCOUNTING_SESSION_SECRET=
BITCOIN_ACCOUNTING_SESSION_COOKIE=ba_session
# Leave unset to auto-default: secure in production, insecure in development
# BITCOIN_ACCOUNTING_SESSION_COOKIE_SECURE=
BITCOIN_ACCOUNTING_SESSION_TTL_SECONDS=604800

# Optional Bitcoin node presence on the web dashboard
# Leave disabled if you do not want the dashboard querying a local bitcoind.
BITCOIN_CHAIN_STATUS_ENABLED=0

# Local bitcoind RPC endpoint
# Example: http://127.0.0.1:8332
BITCOIN_RPC_URL=

# Preferred auth method: point at bitcoind's .cookie file
# Example: /home/bitcoin/.bitcoin/.cookie
BITCOIN_RPC_COOKIE_FILE=

# Alternative auth method: explicit RPC user/password
# Leave blank when using BITCOIN_RPC_COOKIE_FILE
BITCOIN_RPC_USER=
BITCOIN_RPC_PASSWORD=

# RPC timeout in seconds for the dashboard chain-status card
BITCOIN_RPC_TIMEOUT_SECONDS=3
